{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kpubdata.dev/schemas/dataset-spec.schema.json",
  "title": "KPubData 데이터셋 Spec",
  "description": "선언적 데이터셋 정의. Generic Executor가 이 문서만으로 조회를 수행한다. 축별 enum 값은 docs/internal/adapter-inventory.md(Phase 0 전수조사)에서 도출됐다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "provider",
    "title",
    "endpoint",
    "auth",
    "response",
    "pagination",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
      "description": "{provider}.{dataset_key} — catalogue 데이터셋 키 네임스페이스와 동일"
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Provider 식별자 (datago, localdata, ...)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "데이터셋 표제(한국어 우선)"
    },
    "description": {
      "type": "string",
      "description": "데이터셋 설명"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "doc_version": {
          "type": "string",
          "description": "활용가이드 문서 버전"
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "operation",
        "method"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "operation": {
          "type": "string",
          "description": "연산(경로 세그먼트). 예: getRTMSDataSvcAptTradeDev"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "format_param": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "description": "응답 포맷 선택 파라미터 (data.go.kr 계열의 dataType/_type/resultType 등)",
          "properties": {
            "name": {
              "type": "string"
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "json": {
                  "type": "string"
                },
                "xml": {
                  "type": "string"
                }
              }
            }
          }
        },
        "path_template": {
          "type": "string",
          "description": "전체 URL 템플릿(선택). {base_url}/{key}/{operation}/{start}/{end} 플레이스홀더 사용. 경로 세그먼트 인증·범위(bok/seoul 계열)에 필요하다."
        },
        "insecure_http_reason": {
          "type": "string",
          "minLength": 1,
          "description": "base_url이 http://일 때만 의미가 있다. 제공기관이 https를 지원하지 않는 등 평문을 쓸 수밖에 없는 사유. 사유가 없다면 base_url을 https로 바꾸고 재기록한다."
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "query_param",
            "path_segment",
            "oauth_exchange",
            "none"
          ]
        },
        "param_name": {
          "type": "string",
          "description": "type=query_param인 경우 키를 실을 파라미터명 (serviceKey, apiKey, KEY, key, OC, Key 등)"
        },
        "provider_key": {
          "type": "string",
          "description": "config 키. 기본값은 provider와 동일. datago 계열 공유 키(localdata 등)는 'datago'로 명시"
        }
      }
    },
    "params": {
      "type": "array",
      "description": "데이터 필터 파라미터. 페이지네이션/인증/포맷 파라미터는 여기에 두지 않는다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Provider 원본 파라미터명"
          },
          "alias": {
            "type": "string",
            "description": "라이브러리 노출명(생략 시 name과 동일)"
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "date_yyyymmdd",
              "date_yyyymm"
            ]
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "enum": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "example": {
            "type": [
              "string",
              "integer",
              "number"
            ]
          },
          "max_age_days": {
            "type": "integer",
            "minimum": 1,
            "description": "이 파라미터의 값이 날짜일 때 제공기관이 응답하는 최근 창(일 단위). 예제 값이 창을 넘으면 make verify가 만료로 실패한다 (#734)."
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "envelope",
        "error"
      ],
      "properties": {
        "format": {
          "enum": [
            "json",
            "xml",
            "geojson"
          ]
        },
        "envelope": {
          "enum": [
            "datago_standard",
            "datago_gyeonggi_msg",
            "datago_its_flat",
            "datago_odcloud",
            "localdata_rows",
            "semas_rows",
            "lofin_head_row",
            "neis_double_list",
            "kipris_items",
            "seoul_service_row",
            "bok_statistic_row",
            "kosis_top_array",
            "law_item_key",
            "korean_channel",
            "fds_row"
          ]
        },
        "items_path": {
          "type": "string",
          "description": "루트부터 레코드 배열까지의 점 경로. 예: response.body.items.item"
        },
        "total_count_path": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "style"
          ],
          "properties": {
            "style": {
              "enum": [
                "header_result_code",
                "result_code",
                "status_code",
                "err_cd",
                "err_field",
                "http_status"
              ]
            },
            "code_path": {
              "type": "string"
            },
            "ok_values": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "description": "성공 코드. 예: [\"00\", \"000\", 0]"
            }
          }
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "page_no_rows",
            "page_display",
            "pindex_psize",
            "index_range",
            "date_window",
            "none"
          ]
        },
        "page_param": {
          "type": "string"
        },
        "size_param": {
          "type": "string"
        },
        "max_size": {
          "type": "integer",
          "minimum": 1
        },
        "start_index_base": {
          "type": "integer",
          "description": "index_range 계열의 시작 오프셋(보통 1)"
        }
      }
    },
    "fields": {
      "type": "array",
      "description": "정규화 규칙. 비워두면 원본 필드를 그대로 전달한다(현재 datago 어댑터와 동일 동작).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "source_name": {
            "type": "string",
            "description": "원본 필드명. 생략 시 name과 동일"
          },
          "name": {
            "type": "string",
            "description": "정규 필드명"
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          },
          "unit": {
            "type": "string",
            "description": "예: 원, 천원"
          },
          "transform": {
            "enum": [
              "date_yyyymmdd",
              "date_yyyymm",
              "to_int",
              "to_float",
              "strip_comma"
            ],
            "description": "적용 순서: transform 단일 적용 후 타입 캐스팅"
          },
          "description": {
            "type": "string"
          },
          "semantic_kind": {
            "enum": [
              "code",
              "measure",
              "date",
              "period",
              "text",
              "flag"
            ],
            "description": "값의 의미 (ADR 0006). code 는 string 만, measure 는 integer/number 만. 생략 = 모름"
          },
          "title": {
            "type": "string",
            "description": "표시명 → FieldDescriptor.title"
          },
          "format": {
            "type": "string",
            "description": "표시 형식 힌트 → FieldConstraints.format (예: YYYY-MM)"
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "description": "record·smoke·예제 생성에 공통으로 쓰는 호출 파라미터 조합. 최소 1개 권장.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "예제명. fixture 파일명으로도 사용"
          },
          "description": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "description": "정규 Query 필터 값. 예: {LAWD_CD: \"11110\", DEAL_YMD: \"202508\"}"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1
          },
          "format": {
            "enum": [
              "json",
              "xml"
            ],
            "description": "응답 포맷 재정의(기본: response.format)"
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "description": "데이터 이용 허락 조건. 공공누리 유형 등 라이선스 정보를 명시한다.",
      "properties": {
        "type": {
          "type": "string",
          "description": "라이선스 유형. 예: 공공누리_1유형, 공공누리_2유형, KRX_별도계약, 자유이용"
        },
        "commercial_use": {
          "type": "boolean",
          "description": "상업적 이용 가능 여부"
        },
        "attribution_required": {
          "type": "boolean",
          "description": "출처 표시 의무 여부"
        },
        "modification_allowed": {
          "type": "boolean",
          "description": "변경 허용 여부"
        },
        "note": {
          "type": "string",
          "description": "라이선스 관련 부가 설명"
        },
        "redistribution": {
          "type": "string",
          "enum": [
            "allowed",
            "non_commercial",
            "forbidden",
            "unknown"
          ],
          "description": "Redistribution policy. Default unknown — not publishable (#525)."
        },
        "attribution": {
          "type": "string",
          "description": "Exact attribution text to display (#525)."
        },
        "quota": {
          "type": "string",
          "description": "Rate limit or traffic cap from the provider (#525)."
        },
        "pii_columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Column names that may contain PII (#525)."
        }
      }
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "broken",
        "unstable"
      ]
    },
    "last_verified": {
      "type": "string",
      "format": "date",
      "description": "마지막 실API 검증일 (SUPPORTED_DATA.md와 연동)"
    }
  }
}
